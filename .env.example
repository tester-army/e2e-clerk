# Copy to .env.local. next dev reads it, and e2e.config.ts loads it for the test runner.

# The Clerk app's development keys: `npx clerk@latest env pull`, or the API keys page in the Clerk Dashboard.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# The password the tests sign in with as ada+clerk_test@example.com, who is created on the first run.
# At least 15 characters, and not one found in a data breach.
CLERK_TEST_PASSWORD=

# The agent's model, through the Vercel AI Gateway. Only agent steps need it.
AI_GATEWAY_API_KEY=

# Optional: test another URL. Defaults to http://localhost:3000.
# APP_URL=
